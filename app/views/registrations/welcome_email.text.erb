<%= t("registrations.welcome_email.your_id", id: @user.person.diaspora_handle) %>

<%= t("registrations.welcome_email.verify") %>

<%= confirm_email_url(token: @user.confirm_email_token) %>

<% if @podmin_message.present? %>
